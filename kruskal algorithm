
#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

struct Edge {
    int u, v, w;
};

bool compare(Edge a, Edge b) {
    return a.w < b.w;
}

int parent[1000];

int find(int x) {
    if (parent[x] == x)
        return x;
    return parent[x] = find(parent[x]);
}

void unite(int u, int v) {
    parent[find(u)] = find(v);
}

int main() {
    int n, e;
    cin >> n >> e;

    vector<Edge> edges(e);

    for (int i = 0; i < e; i++) {
        cin >> edges[i].u >> edges[i].v >> edges[i].w;
    }

    sort(edges.begin(), edges.end(), compare);

    for (int i = 0; i < n; i++)
        parent[i] = i;

    int total = 0;

    cout << "Edges in MST:\n";

    for (auto edge : edges) {
        int u = edge.u;
        int v = edge.v;
        int w = edge.w;

        if (find(u) != find(v)) {
            cout << u << " - " << v << " : " << w << endl;
            total += w;
            unite(u, v);
        }
    }

    cout << "Minimum cost of MST = " << total;

    return 0;
}
